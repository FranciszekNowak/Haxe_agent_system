{
  "name": "ClickUp OAuth Onboarding (v1)",
  "active": false,
  "nodes": [
    {
      "id": "oauth-start",
      "name": "OAuth Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 80],
      "webhookId": "clickup-oauth-start",
      "notes": "ADR-054 Block 1. The single self-serve onboarding link: hand https://agents.skalus.com/webhook/clickup-oauth-start to a team member. They open it logged into ClickUp as themselves; it mints CSRF state and 302s to ClickUp's CLASSIC consent (phase 1 of 2). The whole chain mints TWO tokens (classic REST -> Supabase Vault; MCP-OAuth -> Anthropic Vault) under whoever is logged in here.",
      "parameters": {
        "httpMethod": "GET",
        "path": "clickup-oauth-start",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "mint-state",
      "name": "Mint State + Client ID",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 80],
      "notes": "Inserts a single-use CSRF state (phase defaults to 'classic', migration 041/043) and reads the CLASSIC app client_id from the Vault getter (migration 040). DB failure -> errorWorkflow CRITICAL.",
      "parameters": {
        "operation": "executeQuery",
        "query": "with s as (insert into clickup_oauth_state default values returning state) select s.state, (public.get_clickup_oauth_app()->>'client_id') as client_id from s;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "redirect-clickup",
      "name": "Redirect to ClickUp",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [440, 80],
      "notes": "302 to ClickUp's in-app CLASSIC consent (Block-0: authorize at app.clickup.com/api). redirect_uri must match the registered app redirect exactly.",
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "=https://app.clickup.com/api?client_id={{ $json.client_id }}&redirect_uri=https%3A%2F%2Fagents.skalus.com%2Fwebhook%2Fclickup-oauth-callback&state={{ $json.state }}",
        "options": {
          "responseCode": 302
        }
      }
    },
    {
      "id": "oauth-callback",
      "name": "OAuth Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 320],
      "webhookId": "clickup-oauth-callback",
      "notes": "CLASSIC callback. ClickUp redirects here with ?code=&state= after consent 1. Registered redirect_uri: https://agents.skalus.com/webhook/clickup-oauth-callback. Ends by chaining a 302 to the MCP consent (phase 2), NOT a success page.",
      "parameters": {
        "httpMethod": "GET",
        "path": "clickup-oauth-callback",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "consume-state",
      "name": "Consume State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 320],
      "notes": "Single-use CSRF check for the classic phase: atomically deletes the matching fresh (<15min) phase='classic' state. Reused/expired/forged -> valid=false -> restart page (benign).",
      "parameters": {
        "operation": "executeQuery",
        "query": "with del as (delete from clickup_oauth_state where state = $1 and phase = 'classic' and created_at > now() - interval '15 minutes' returning state) select exists(select 1 from del) as valid;",
        "options": {
          "queryReplacement": "={{ [ $('OAuth Callback').first().json.query.state ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "state-valid",
      "name": "State Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [440, 320],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond-expired",
      "name": "Respond Link Expired",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [440, 540],
      "notes": "Shared 400 page for an invalid/expired state in EITHER phase (classic or mcp callback). Responds to whichever webhook started this execution.",
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html lang=\"pl\"><head><meta charset=\"utf-8\"><title>Link wygasł</title></head><body style=\"font-family:sans-serif;max-width:32rem;margin:4rem auto;text-align:center\"><h2>Link wygasł lub jest nieprawidłowy</h2><p>Otwórz ponownie link onboardingu i zatwierdź dostęp w ciągu 15 minut.</p></body></html>",
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    },
    {
      "id": "get-app-creds",
      "name": "Get App Creds",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [660, 320],
      "notes": "Reads {client_id, client_secret} (migration 040) for the CLASSIC token exchange. Throws if DB down -> errorWorkflow CRITICAL.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.get_clickup_oauth_app() as app;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "exchange-code",
      "name": "Exchange Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 320],
      "notes": "CLASSIC exchange: POST oauth/token with client_id+client_secret+code (query params; ClickUp's canonical form). Single-use code -> NO retry. Returns {access_token} = the REST token. Failure -> failure page + CRITICAL.",
      "parameters": {
        "method": "POST",
        "url": "=https://api.clickup.com/api/v2/oauth/token?client_id={{ $json.app.client_id }}&client_secret={{ $json.app.client_secret }}&code={{ $('OAuth Callback').first().json.query.code }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "get-user",
      "name": "Get ClickUp User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 320],
      "notes": "Identifies the consenting user (id/username/email) with the REST token so the mapping row + carried mcp-phase identity are keyed correctly. ClickUp REST takes the raw token in Authorization (no 'Bearer ').",
      "parameters": {
        "method": "GET",
        "url": "https://api.clickup.com/api/v2/user",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "existing-row",
      "name": "Existing Row?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1320, 320],
      "notes": "Re-onboard guard: if an active mapping row already exists, stop before re-running the consent chain. alwaysOutputData so a no-row result still flows (empty item). To RE-KEY a user, delete their row first.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select clickup_user_id, status from user_data_and_config where clickup_user_id = $1;",
        "options": {
          "queryReplacement": "={{ [ String($('Get ClickUp User').first().json.user.id) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "id": "already-connected",
      "name": "Already Connected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1540, 320],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ !!$json.clickup_user_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond-already",
      "name": "Respond Already Connected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1540, 540],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html lang=\"pl\"><head><meta charset=\"utf-8\"><title>Już połączono</title></head><body style=\"font-family:sans-serif;max-width:32rem;margin:4rem auto;text-align:center\"><h2>Twoje konto ClickUp jest już połączone ✓</h2><p>Nie musisz nic robić. Możesz zamknąć tę kartę.</p></body></html>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    },
    {
      "id": "store-rest-token",
      "name": "Store REST Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1760, 320],
      "notes": "Option A: persist the CLASSIC REST token in Supabase Vault (migration 042 set_clickup_rest_token) for Block-4 as-U extraction. The REST token is 401 on the MCP, so it does NOT belong in the Anthropic Vault. Idempotent. Failure -> failure page + CRITICAL.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.set_clickup_rest_token($1, $2) as stored;",
        "options": {
          "queryReplacement": "={{ [ String($('Get ClickUp User').first().json.user.id), $('Exchange Code').first().json.access_token ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "dcr-register",
      "name": "DCR Register",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 320],
      "notes": "MCP phase: Dynamic Client Registration against the hosted MCP's OWN OAuth server (mcp.clickup.com/oauth/register). Public client; minimal RFC-7591 body (extra fields 400 - probe). Returns {client_id}. Failure -> failure page + CRITICAL.",
      "parameters": {
        "method": "POST",
        "url": "https://mcp.clickup.com/oauth/register",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ redirect_uris: ['https://agents.skalus.com/webhook/clickup-mcp-callback'], token_endpoint_auth_method: 'none', grant_types: ['authorization_code'], response_types: ['code'] }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "gen-verifier",
      "name": "Gen Verifier",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [2200, 320],
      "notes": "PKCE: generate a 64-char hex code_verifier (unreserved chars, valid 43-128 length). Code-node crypto is blocked on this CE (CLAUDE.md) -> use the native Crypto node.",
      "parameters": {
        "action": "generate",
        "encodingType": "hex",
        "stringLength": 64,
        "dataPropertyName": "verifier"
      }
    },
    {
      "id": "hash-challenge",
      "name": "Hash Challenge",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [2420, 320],
      "notes": "PKCE: code_challenge = SHA256(verifier) as base64; the Redirect node converts base64 -> base64url with plain string ops (split/join), which the sandbox allows. S256 per the MCP metadata.",
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.verifier }}",
        "dataPropertyName": "challenge_b64",
        "encoding": "base64",
        "binaryData": false
      }
    },
    {
      "id": "mint-mcp-state",
      "name": "Mint MCP State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2640, 320],
      "notes": "Persist the PKCE verifier + DCR client_id + the consenting user's identity on a phase='mcp' state row (migration 043), so the mcp callback can finish without re-identifying (MCP token is 401 on REST). Returns the new state. Failure -> failure page + CRITICAL.",
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into clickup_oauth_state (phase, code_verifier, mcp_client_id, clickup_user_id, clickup_username, clickup_email) values ('mcp', $1, $2, $3, $4, $5) returning state;",
        "options": {
          "queryReplacement": "={{ [ $('Gen Verifier').first().json.verifier, $('DCR Register').first().json.client_id, String($('Get ClickUp User').first().json.user.id), ($('Get ClickUp User').first().json.user.username || ''), ($('Get ClickUp User').first().json.user.email || '') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "redirect-mcp",
      "name": "Redirect to MCP",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [2860, 320],
      "notes": "302 to the hosted MCP's consent (mcp.clickup.com/oauth/authorize), PKCE S256. challenge is base64url-encoded inline (split/join, no regex/crypto). resource indicator + scope=read (ClickUp grants read+write regardless; read-only is enforced by the Block-3 toolset allowlist). Ends the CLASSIC callback execution.",
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "=https://mcp.clickup.com/oauth/authorize?response_type=code&client_id={{ $('DCR Register').first().json.client_id }}&redirect_uri=https%3A%2F%2Fagents.skalus.com%2Fwebhook%2Fclickup-mcp-callback&code_challenge={{ $('Hash Challenge').first().json.challenge_b64.split('+').join('-').split('/').join('_').split('=').join('') }}&code_challenge_method=S256&scope=read&resource=https%3A%2F%2Fmcp.clickup.com&state={{ $json.state }}",
        "options": {
          "responseCode": 302
        }
      }
    },
    {
      "id": "mcp-callback",
      "name": "MCP Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 760],
      "webhookId": "clickup-mcp-callback",
      "notes": "MCP phase callback. The hosted MCP redirects here with ?code=&state= after consent 2. This is the DCR-registered redirect_uri: https://agents.skalus.com/webhook/clickup-mcp-callback.",
      "parameters": {
        "httpMethod": "GET",
        "path": "clickup-mcp-callback",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "consume-mcp-state",
      "name": "Consume MCP State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 760],
      "notes": "Single-use CSRF check for the mcp phase: atomically deletes the matching fresh phase='mcp' state and RETURNS the carried verifier + client_id + identity for the exchange and the mapping row.",
      "parameters": {
        "operation": "executeQuery",
        "query": "with del as (delete from clickup_oauth_state where state = $1 and phase = 'mcp' and created_at > now() - interval '15 minutes' returning code_verifier, mcp_client_id, clickup_user_id, clickup_username, clickup_email) select exists(select 1 from del) as valid, (select code_verifier from del) as code_verifier, (select mcp_client_id from del) as mcp_client_id, (select clickup_user_id from del) as clickup_user_id, (select clickup_username from del) as clickup_username, (select clickup_email from del) as clickup_email;",
        "options": {
          "queryReplacement": "={{ [ $('MCP Callback').first().json.query.state ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "mcp-state-valid",
      "name": "MCP State Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [440, 760],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "m1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "exchange-mcp-code",
      "name": "Exchange MCP Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 760],
      "notes": "MCP token exchange: POST mcp.clickup.com/oauth/token, form-urlencoded, public client (code_verifier, no secret). Single-use code -> NO retry. Returns {access_token} (~10y, store as static_bearer). Failure -> failure page + CRITICAL.",
      "parameters": {
        "method": "POST",
        "url": "https://mcp.clickup.com/oauth/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "authorization_code"
            },
            {
              "name": "code",
              "value": "={{ $('MCP Callback').first().json.query.code }}"
            },
            {
              "name": "redirect_uri",
              "value": "https://agents.skalus.com/webhook/clickup-mcp-callback"
            },
            {
              "name": "client_id",
              "value": "={{ $('Consume MCP State').first().json.mcp_client_id }}"
            },
            {
              "name": "code_verifier",
              "value": "={{ $('Consume MCP State').first().json.code_verifier }}"
            },
            {
              "name": "resource",
              "value": "https://mcp.clickup.com"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "get-anthropic-key",
      "name": "Get Anthropic Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 760],
      "notes": "Reads the Anthropic API key (migration 034) to create the per-user Vault + credential for the MCP token.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.get_anthropic_key() as key;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "create-vault",
      "name": "Create Vault",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 760],
      "notes": "One Anthropic Vault PER USER (Vault creds are keyed by mcp_server_url; same-URL creds 409 in one vault). Identity comes from the carried mcp-state (Get ClickUp User did not run in this execution). Failure -> failure page + CRITICAL.",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/vaults",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ display_name: 'clickup ' + ($('Consume MCP State').first().json.clickup_username || $('Consume MCP State').first().json.clickup_user_id) + ' (ADR-054)' }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "create-credential",
      "name": "Create Credential",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 760],
      "notes": "static_bearer credential holding U's MCP-OAuth token (NOT the REST token), keyed to the hosted ClickUp MCP. This is the discovery scope-enforcing credential. Failure -> Rollback Vault then CRITICAL.",
      "parameters": {
        "method": "POST",
        "url": "=https://api.anthropic.com/v1/vaults/{{ $json.id }}/credentials",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Get Anthropic Key').first().json.key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ display_name: 'clickup ' + ($('Consume MCP State').first().json.clickup_username || $('Consume MCP State').first().json.clickup_user_id) + ' (U)', auth: { type: 'static_bearer', mcp_server_url: 'https://mcp.clickup.com/mcp', token: $('Exchange MCP Code').first().json.access_token } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "rollback-vault",
      "name": "Rollback Vault",
      "type": "n8n-nodes-base.httpRequest",
