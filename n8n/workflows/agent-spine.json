    {
      "id": "sum-cost",
      "name": "Sum Task Cost",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [960, 300],
      "notes": "Authoritative task cost = SUM(agent_runs.cost_pln) for this task (ADR-024). Idempotent: the CU field mirrors this sum, no read-modify-write drift. onError=continueErrorOutput -> failure alerts, run not killed.",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(sum(cost_pln), 0) as total\nfrom agent_runs\nwhere clickup_task_id = $1;",
        "options": { "queryReplacement": "={{ [ $('Build Prompt').first().json.clickup_task_id ] }}" }
      },
      "credentials": { "postgres": { "id": "EjK3iACTbSNRDhVz", "name": "Postgres / supabase connection" } }
    },
    {
      "id": "update-cost",
      "name": "Update CU Cost Field",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 300],
      "notes": "Writes the running total to ClickUp '[AI] Koszt akcji [PLN]' (field ca7a3874...). onError=continueErrorOutput -> WARN on failure (silent-failure guard). Deterministic field write is permitted (ADR-026): capability is never exposed to the LLM. Uses the single agent ClickUp token (no separate telemetry identity — decided against).",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "=https://api.clickup.com/api/v2/task/{{ $('Build Prompt').first().json.clickup_task_id }}/field/ca7a3874-b83d-403c-8266-426935e38eae",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "clickUpApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ value: Number($json.total) }) }}",
        "options": {}
      },
      "credentials": { "clickUpApi": { "id": "QRrgf6hteyGWSJyv", "name": "ClickUp account" } }
    },
