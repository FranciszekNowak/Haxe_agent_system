    {
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 304],
      "notes": "Stub prompt assembler (v1): context -> one prompt string with the soft output structure (Wyniki/Pytania/Decyzje/Sugestie, §13.1); resolves reviewer_user_id (manual: form field else operator 2521617; auto path will use assignee/creator) and carries impact/clickup_task_id/triggered_by/invocation_type. Later: GLOBAL agent-rules doc + person prefs (core model). Pure shaping (ADR-019).",
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst ct = ctx.current_task || {};\nconst chain = ctx.ancestor_chain || [];\nconst leaves = ctx.linked_doc_leaves || [];\n\nconst lines = [];\nlines.push('# Zadanie');\nlines.push(ct.name || '(bez nazwy)');\nif (ct.description) { lines.push(''); lines.push(ct.description); }\n\nif (chain.length) {\n  lines.push('');\n  lines.push('# Kontekst nadrzędny (od najogólniejszego do najbliższego)');\n  for (const a of chain.slice().reverse()) {\n    lines.push('');\n    lines.push('## ' + (a.name || ''));\n    if (a.description) lines.push(a.description);\n  }\n}\n\nif (leaves.length) {\n  lines.push('');\n  lines.push('# Szczegółowe wytyczne');\n  for (const l of leaves) { lines.push('- ' + (l.name || '')); if (l.content) lines.push(l.content); }\n}\n\nlines.push('');\nlines.push('Przygotuj wynik dla powyższego zadania. Możesz rozumować swobodnie, ale ostateczną odpowiedź zwróć w poniższej strukturze (pomiń sekcję, jeśli pusta):');\nlines.push('');\nlines.push('## Wyniki');\nlines.push('## Pytania do zlecającego');\nlines.push('## Decyzje i kompromisy');\nlines.push('');\nlines.push('---');\nlines.push('## Sugestie do procesu');\n\nconst prompt = lines.join('\\n');\n\nconst OPERATOR_ID = '2521617';\nlet formReviewer = '';\ntry { formReviewer = ($('Form Trigger').first().json.reviewer_user_id || '').toString().trim(); } catch (e) {}\nconst reviewer_user_id = formReviewer || OPERATOR_ID; // manual run -> triggerer (operator default); auto path uses assignee/creator (Increment 2)\n\nreturn [{ json: {\n  prompt,\n  impact: ctx.impact || '',\n  personal_data: true,\n  task_type: '',\n  clickup_task_id: (ct.id || ''),\n  triggered_by: 'explicit_command',\n  invocation_type: 'explicit',\n  reviewer_user_id,\n  assignee_user_id: ctx.assignee_user_id || '',\n  creator_user_id: ctx.creator_user_id || ''\n} }];"
      }
    },
