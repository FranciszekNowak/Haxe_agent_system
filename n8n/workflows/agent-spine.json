    {
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 304],
      "notes": "Stub prompt assembler (v1): turns the context object into one prompt string + carries impact for routing + clickup_task_id/triggered_by/invocation_type for logging. Later this incorporates the GLOBAL agent-rules doc + person preferences (core model). Pure shaping (ADR-019).",
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst ct = ctx.current_task || {};\nconst chain = ctx.ancestor_chain || [];\nconst leaves = ctx.linked_doc_leaves || [];\n\nconst lines = [];\nlines.push('# Zadanie');\nlines.push(ct.name || '(bez nazwy)');\nif (ct.description) { lines.push(''); lines.push(ct.description); }\n\nif (chain.length) {\n  lines.push('');\n  lines.push('# Kontekst nadrzędny (od najogólniejszego do najbliższego)');\n  for (const a of chain.slice().reverse()) {\n    lines.push('');\n    lines.push('## ' + (a.name || ''));\n    if (a.description) lines.push(a.description);\n  }\n}\n\nif (leaves.length) {\n  lines.push('');\n  lines.push('# Szczegółowe wytyczne');\n  for (const l of leaves) { lines.push('- ' + (l.name || '')); if (l.content) lines.push(l.content); }\n}\n\nlines.push('');\nlines.push('Przygotuj odpowiedź dla powyższego zadania.');\n\nconst prompt = lines.join('\\n');\nreturn [{ json: { prompt, impact: ctx.impact || '', personal_data: true, task_type: '', clickup_task_id: (ct.id || ''), triggered_by: 'explicit_command', invocation_type: 'explicit' } }];"
      }
    },
