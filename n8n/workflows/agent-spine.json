        "resource": "comment",
        "operation": "create",
        "commentOn": "task",
        "id": "={{ $('Build Prompt').first().json.clickup_task_id }}",
        "commentText": "=## 🤖 Wersja robocza (AI)\n\n{{ $('Call Invoke Model').first().json.completion }}\n\n—\n_Przygotowane przez agenta AI (model: {{ $('Call Invoke Model').first().json.model }}, koszt: {{ $('Call Invoke Model').first().json.cost_pln }} PLN). Do weryfikacji — nie finalizuje zadania._",
        "additionalFields": { "assignee": "={{ $('Build Prompt').first().json.reviewer_user_id }}", "notifyAll": false }
      },
      "credentials": { "clickUpApi": { "id": "QRrgf6hteyGWSJyv", "name": "ClickUp account" } }
    },
