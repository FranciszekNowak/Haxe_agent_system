    {
      "id": "collect-research-results",
      "name": "Collect Research Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1984, 304],
      "notes": "Terminal node: all branches (NIE, gate-fail, research-success, research-fail) converge here. Returns { web_findings, web_sources } for the caller.",
      "parameters": {
        "jsCode": "let web_findings = '', web_sources = [];\ntry {\n  const rw = $('Call Research the web').first().json;\n  if (rw) {\n    web_findings = rw.completion || '';\n    web_sources = rw.sources || [];\n  }\n} catch(e) {}\nreturn [{ json: { web_findings, web_sources } }];"
      }
    }
