    {
      "id": "if-needs-research",
      "name": "If Needs Research?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [660, 300],
      "parameters": {
        "conditions": {
          "options": { "version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            { "id": "g1", "leftValue": "={{ ($json.completion || '').toUpperCase() }}", "rightValue": "TAK", "operator": { "type": "string", "operation": "contains" } }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "lookup-research-routing",
      "name": "Lookup Research Routing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "select litellm_model, temperature, max_tokens, price_in_usd_per_1k, price_out_usd_per_1k, impact\nfrom model_routing\nwhere impact in ($1, '__default__') and personal_data = $2 and active = true and modality = 'text'\norder by (impact = $1) desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [ $('When Called').first().json.impact || '__default__', $('When Called').first().json.personal_data === true ] }}"
        }
      },
      "credentials": { "postgres": { "id": "EjK3iACTbSNRDhVz", "name": "Postgres / supabase connection" } },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "lookup-research-params",
      "name": "Lookup Research Params",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1100, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "select max_research_rounds, tavily_max_results\nfrom research_parameters\nwhere impact in ($1, '__default__') and active = true\norder by (impact = $1) desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [ $('When Called').first().json.impact || '__default__' ] }}"
        }
      },
      "credentials": { "postgres": { "id": "EjK3iACTbSNRDhVz", "name": "Postgres / supabase connection" } },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "resolve-research-inputs",
      "name": "Resolve Research Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 200],
      "parameters": {
        "jsCode": "const inp = $('When Called').first().json;\nconst reviewer = (inp.reviewer_user_id || '2521617').toString();\nlet rr = null; try { const r = $('Lookup Research Routing').first().json; if (r && r.litellm_model) rr = r; } catch(e) {}\nconst litellm_model = rr ? rr.litellm_model : 'haxe-sonnet-4-6-direct';\nconst max_tokens = (rr && rr.max_tokens != null) ? Number(rr.max_tokens) : 4000;\nconst temperature = (rr && rr.temperature != null && rr.temperature !== '') ? Number(rr.temperature) : null;\nlet rp = null; try { const p = $('Lookup Research Params').first().json; if (p && p.max_research_rounds != null) rp = p; } catch(e) {}\nconst max_research_rounds = (rp && rp.max_research_rounds != null) ? Number(rp.max_research_rounds) : 3;\nconst tavily_max_results = (rp && rp.tavily_max_results != null) ? Number(rp.tavily_max_results) : 5;\nconst tcomment = (inp.triggering_comment_text || '').toString();\nconst userPrompt = 'Jestes asystentem researchu. Zbierz z internetu aktualne, zewnetrzne informacje potrzebne do wykonania ponizszego zadania (np. ceny, kursy, specyfikacje, biezace fakty). Wykonaj potrzebne wyszukiwania, a nastepnie zwroc ZWIEZLE ustalenia (fakty + liczby), bez wykonywania samego zadania. NIE umieszczaj w zapytaniach danych osobowych (nazwiska, e-maile, numery zamowien).\\n\\nZADANIE:\\n' + (inp.task_name || '') + '\\n' + (inp.task_description || '') + (tcomment ? ('\\n\\nWIADOMOSC UZYTKOWNIKA:\\n' + tcomment) : '');\nconst messages = JSON.stringify([{ role: 'user', content: userPrompt }]);\nreturn [{ json: {\n  litellm_model: litellm_model,\n  messages: messages,\n  max_tokens: max_tokens,\n  temperature: temperature,\n  depth: 0,\n  max_depth: max_research_rounds,\n  acc_in: 0, acc_out: 0, acc_usd: 0, acc_searches: 0,\n  sources: '[]',\n  tavily_max_results: tavily_max_results,\n  calls: '[]',\n  clickup_task_id: inp.clickup_task_id || '',\n  caller_user_id: reviewer,\n  process_type: inp.process_type || '',\n  triggered_by: inp.triggered_by || 'explicit_command',\n  invocation_type: inp.invocation_type || 'explicit',\n  impact: inp.impact || ''\n} }];"
      },
      "notes": "Resolves research model + depth/results from research_parameters and builds the research prompt. Reads inputs from SW1 trigger (When Called)."
    },
