            "invocation_type": "={{ $json.invocation_type }}",
            "caller_user_id": "={{ $json.caller_user_id }}",
            "process_type": "={{ $json.process_type }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
