    {
      "id": "build-gate-request",
      "name": "Build Gate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "jsCode": "const inp = $input.first().json;\nconst reviewer = (inp.reviewer_user_id || '2521617').toString();\nconst tcomment = (inp.triggering_comment_text || '').toString();\nconst prompt = 'Czy to zadanie wymaga aktualnych informacji z internetu (ceny, biezace wydarzenia, kursy walut, specyfikacje produktow, swieze fakty spoza wiedzy modelu), aby je dobrze wykonac? Odpowiedz wylacznie jednym slowem: TAK lub NIE.\\n\\nZADANIE:\\n' + (inp.task_name || '') + '\\n' + (inp.task_description || '') + (tcomment ? ('\\n\\nWIADOMOSC UZYTKOWNIKA:\\n' + tcomment) : '');\nreturn [{ json: {\n  prompt: prompt,\n  model_override: 'haxe-haiku-4-5-direct',\n  impact: inp.impact || '',\n  clickup_task_id: inp.clickup_task_id || '',\n  triggered_by: inp.triggered_by || 'explicit_command',\n  invocation_type: inp.invocation_type || 'explicit',\n  caller_user_id: reviewer,\n  process_type: inp.process_type || ''\n} }];"
      },
      "notes": "Builds the cheap Haiku TAK/NIE gate prompt from SW1 trigger inputs."
    },
    {
      "id": "research-gate",
      "name": "Research Gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [440, 300],
      "parameters": {
        "workflowId": { "__rl": true, "value": "XcOIVdZnVCCWNPeb", "mode": "list", "cachedResultName": "Invoke Model (v1)" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "prompt": "={{ $json.prompt }}",
            "model_override": "={{ $json.model_override }}",
            "impact": "={{ $json.impact }}",
            "clickup_task_id": "={{ $json.clickup_task_id }}",
            "triggered_by": "={{ $json.triggered_by }}",
            "invocation_type": "={{ $json.invocation_type }}",
            "caller_user_id": "={{ $json.caller_user_id }}",
            "process_type": "={{ $json.process_type }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "onError": "continueErrorOutput",
      "notes": "Cheap Haiku gate: decides if the task needs web research. onError=continueErrorOutput -> fail-open (NIE path)."
    },
