    {
      "id": "lookup-research-routing",
      "name": "Lookup Research Routing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 208],
      "parameters": {
        "operation": "executeQuery",
        "query": "select litellm_model, temperature, max_tokens, price_in_usd_per_1k, price_out_usd_per_1k, impact\nfrom model_routing\nwhere impact in ($1, '__default__') and active = true and modality = 'text'\norder by (impact = $1) desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [ $('When Called').first().json.impact || '__default__' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "lookup-research-params",
      "name": "Lookup Research Params",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1104, 208],
      "parameters": {
        "operation": "executeQuery",
        "query": "select max_research_rounds, tavily_max_results\nfrom research_parameters\nwhere impact in ($1, '__default__') and active = true\norder by (impact = $1) desc\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [ $('When Called').first().json.impact || '__default__' ] }}"
