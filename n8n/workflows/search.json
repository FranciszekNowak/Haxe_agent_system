    {
      "id": "s-merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 112],
      "notes": "Deduplicate search results from all query loop iterations.",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst candidates = [];\nfor (const item of items) {\n  for (const t of (item.json.tasks || [])) {\n    if (!t.id || seen.has(t.id)) continue;\n    seen.add(t.id);\n    const spaceId = String((t.space && t.space.id) || '');\n    candidates.push({ id: t.id, name: t.name || '', space_id: spaceId });\n  }\n}\nconst space_ids = [...new Set(candidates.map(c => c.space_id).filter(Boolean))];\nreturn [{ json: { candidates, space_ids } }];"
      }
    },
