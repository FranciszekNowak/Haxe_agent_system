        "jsCode": "const wc = $('When Called').first().json;\nconst task = wc.current_task || {};\nconst text = (wc.triggering_comment_text || '').trim();\nconst prompt =\n  'Na podstawie zadania i wiadomości użytkownika, wyodrębnij do 5 fraz do wyszukiwania w ClickUp.\\n\\n' +\n  '## Zadanie\\n' + (task.name || '') + '\\n' + (task.description || '').slice(0, 800) + '\\n\\n' +\n  '## Wiadomość użytkownika\\n' + text + '\\n\\n' +\n  'Zwróć TYLKO JSON (bez dodatkowego tekstu):\\n' +\n  '{\"queries\": [\"fraza 1\", \"fraza 2\"], \"reason\": \"krótki powód\"}\\n' +\n  'Jeśli brak zewnętrznych odniesień: {\"queries\": [], \"reason\": \"brak\"}';\nreturn [{ json: { search_prompt: prompt } }];"
