    {
      "id": "s-build-output",
      "name": "Build Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3520, 288],
      "notes": "Assemble final output. Uses node references with try/catch so all convergence paths work.",
      "parameters": {
        "jsCode": "let task_comments = [];\ntry {\n  const r = $('Fetch Task Comments').first().json;\n  task_comments = (r.comments || []).slice(0, 30).map(c => ({\n    id: c.id,\n    author: (c.user && (c.user.username || c.user.email)) || '',\n    text: (c.comment_text || (c.comment || []).map(op => (op.text || '')).join('')).slice(0, 600),\n    date: c.date\n  }));\n} catch(e) {}\n\nlet additional_context = '';\nlet sources_used = [];\nlet sources_filtered_out = 0;\n\ntry { sources_filtered_out = $('Layer B Filter').first().json.filtered_out || 0; } catch(e) {}\n\ntry {\n  const readItems = $('Read Task').all();\n  const parts = [];\n  for (const item of readItems) {\n    const t = item.json || {};\n    if (!t.id) continue;\n    parts.push('### ' + (t.name || t.id));\n    if (t.description) parts.push(t.description);\n    sources_used.push('task/' + t.id);\n  }\n  additional_context = parts.join('\\n\\n');\n} catch(e) {}\n\nreturn [{ json: { task_comments, additional_context, sources_used, sources_filtered_out } }];"
      }
    },
