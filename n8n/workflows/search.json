    {
      "id": "s-layer-b",
      "name": "Layer B Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2432, 288],
      "notes": "Layer B (ADR-004): keep only artifacts in spaces where caller_user_id is a member. Matches Expand Spaces items (by order) to membership responses. Fail-closed.",
      "parameters": {
        "jsCode": "const membershipItems = $input.all();\nconst expandedItems = $('Expand Spaces').all();\nconst callerUserId = String($('When Called').first().json.caller_user_id || '');\nconst candidates = $('Merge Results').first().json.candidates || [];\n\nconst accessibleSpaces = new Set();\nconst blockedSpaces = new Set();\n\nfor (let i = 0; i < membershipItems.length; i++) {\n  const spaceId = (expandedItems[i] && expandedItems[i].json.space_id) || '';\n  const members = membershipItems[i].json.members || [];\n  const isMember = members.some(m => {\n    const uid = String((m.user && m.user.id !== undefined) ? m.user.id : (m.id || ''));\n    return uid === callerUserId;\n  });\n  if (spaceId) { if (isMember) accessibleSpaces.add(spaceId); else blockedSpaces.add(spaceId); }\n}\n\nconst accessible = candidates.filter(c => accessibleSpaces.has(c.space_id));\nconst filtered_out = candidates.filter(c => blockedSpaces.has(c.space_id)).length;\n\nreturn [{ json: { accessible: accessible.slice(0, 3), filtered_out } }];"
      }
    },
