      "id": "s-parse-queries",
      "name": "Parse Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, -96],
      "notes": "Parse model JSON -> queries[]. Empty array on parse failure.",
      "parameters": {
        "jsCode": "const completion = ($('Extract Queries').first().json.completion || '').trim();\nlet queries = [];\ntry {\n  const match = completion.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    const p = JSON.parse(match[0]);\n    queries = (Array.isArray(p.queries) ? p.queries : [])\n      .filter(q => typeof q === 'string' && q.trim())\n      .slice(0, 5);\n  }\n} catch(e) {}\nreturn [{ json: { queries } }];"
      }
