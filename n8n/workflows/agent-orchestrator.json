    {
      "id": "f99d9a36-d54b-4b0c-8bf7-898792b61d78",
      "name": "Resolve Lane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [752, 192],
      "parameters": {
        "jsCode": "// Block 8: resolve the managed|bare lane flag, fail-safe to bare. Preserves the full Stage A\n// context (spread from Call Assemble Context) so the bare lane's Call Execute LLM mapping ($json.prompt etc.)\n// still resolves downstream. On a DB error (onError=continueRegularOutput passes the input item through) or\n// a missing/malformed flag, agent_lane is absent -> lane_unreadable=true -> bare + a WARN (Lane Unreadable?).\nconst ctx = $('Call Assemble Context').first().json || {};\nconst row = ($input.first() && $input.first().json) || {};\nlet lane = String(row.agent_lane || '').trim().toLowerCase();\nlet lane_unreadable = false;\nif (lane !== 'managed' && lane !== 'bare') { lane_unreadable = true; lane = 'bare'; }\nreturn [{ json: Object.assign({}, ctx, { agent_lane: lane, lane_unreadable: lane_unreadable }) }];"
      }
    },
