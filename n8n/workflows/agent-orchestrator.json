{
  "name": "Agent Orchestrator (v1)",
  "active": true,
  "nodes": [
    {
      "id": "form-trigger",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [0, 224],
      "webhookId": "agent-spine-v1-webhook-001",
      "parameters": {
        "formTitle": "Agent Orchestrator",
        "formDescription": "Enter a ClickUp task ID. Optionally a reviewer ClickUp user ID to @-direct the draft (blank = operator).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "taskId",
              "requiredField": true
            },
            {
              "fieldLabel": "reviewer_user_id"
            },
            {
              "fieldLabel": "triggering_comment_id"
            },
            {
              "fieldLabel": "triggering_comment_text"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "exec-trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 480],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "taskId"
            },
            {
              "name": "reviewer_user_id"
            },
            {
              "name": "caller_username"
            },
            {
              "name": "triggered_by"
            },
            {
              "name": "invocation_type"
            },
            {
              "name": "triggering_comment_id"
            },
            {
              "name": "triggering_comment_text"
            }
          ]
        }
      }
    },
    {
      "id": "call-assemble-context",
      "name": "Call Assemble Context",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [260, 352],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "GGTBvFBgGSNbtUR6",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "taskId": "={{ $json.taskId }}",
            "reviewer_user_id": "={{ $json.reviewer_user_id || '' }}",
            "caller_username": "={{ $json.caller_username || '' }}",
            "triggered_by": "={{ $json.triggered_by || '' }}",
            "invocation_type": "={{ $json.invocation_type || '' }}",
            "triggering_comment_id": "={{ $json.triggering_comment_id || '' }}",
            "triggering_comment_text": "={{ $json.triggering_comment_text || '' }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "status-inprogress",
      "name": "Set Status W trakcie",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 160],
      "notes": "Fires immediately off BOTH triggers (parallel side-branch) so the requester sees '[AI] Status agenta = W trakcie' within ~1s of webhook receipt, not after the ~30s context build (repositioned 2026-06-11; was downstream of Assemble). Fire-and-forget: success output dead-ends, error -> Alert Status Failed (onError:continueErrorOutput) so a status-write failure never blocks the answer. Reads taskId from the trigger item. Post Reply (Stage C) flips the field to 'Zakończono' at the end.",
      "parameters": {
        "method": "POST",
        "url": "=https://api.clickup.com/api/v2/task/{{ $json.taskId || $json.clickup_task_id }}/field/30130652-01c2-451b-954a-c36a455790fe",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "clickUpApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ value: '10290b3f-e47d-4157-a3d4-1bbd770918e8' }) }}",
        "options": {}
      },
      "credentials": {
        "clickUpApi": {
          "id": "QRrgf6hteyGWSJyv",
          "name": "ClickUp account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "alert-status-fail",
      "name": "Alert Status Failed",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [720, 80],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "WARN",
            "source": "agent-orchestrator/status",
            "message": "Nie udało się zaktualizować pola CU '[AI] Status agenta' na W trakcie.",
            "details": "=task={{ $json.taskId || $json.clickup_task_id }}; error={{ ($json.error && $json.error.message) || $json.error || 'unknown' }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "call-execute-llm",
      "name": "Call Execute LLM",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [500, 352],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "9qdJA4xnAGbxqkt9",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "prompt": "={{ $json.prompt }}",
            "impact": "={{ $json.impact }}",
            "personal_data": "={{ $json.personal_data }}",
            "modality": "={{ $json.modality || 'text' }}",
            "task_type": "={{ $json.task_type }}",
            "clickup_task_id": "={{ $json.clickup_task_id }}",
            "triggered_by": "={{ $json.triggered_by }}",
            "invocation_type": "={{ $json.invocation_type }}",
            "caller_user_id": "={{ $json.caller_user_id }}",
            "process_type": "={{ $json.process_type }}",
            "reviewer_user_id": "={{ $json.reviewer_user_id }}",
            "triggering_comment_id": "={{ $json.triggering_comment_id }}",
            "web_sources": "={{ $json.web_sources }}",
            "image_blocks_json": "={{ $json.image_blocks_json || '[]' }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "if-llm-succeeded",
      "name": "If LLM Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [720, 352],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.completion }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "call-post-reply",
      "name": "Call Post Reply",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [940, 352],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "t17moGs7Vxo5ZcFv",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "completion": "={{ $json.completion }}",
            "model": "={{ $json.model }}",
            "cost_pln": "={{ $json.cost_pln }}",
            "clickup_task_id": "={{ $json.clickup_task_id }}",
            "reviewer_user_id": "={{ $json.reviewer_user_id }}",
            "triggering_comment_id": "={{ $json.triggering_comment_id }}",
            "web_sources": "={{ $json.web_sources }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "9dbf3086-cae6-4c7c-85e4-e305574ff872",
      "name": "Context OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [400, 352],
      "notes": "Layer-B reliability guard (silent-failure mandate, 2026-06-11). Call Assemble Context has alwaysOutputData=true so an empty context build still emits an item; this IF gates on a non-empty `prompt`. true -> Call Execute LLM; false -> Alert Context Empty (CRITICAL). Without it, a 0-item Assemble return silently skipped Execute LLM + Post Reply and the run still reported success (the exact failure on task 869dm1z8y).",
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ctx1",
              "leftValue": "={{ $json.prompt }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fb1c0f33-af6a-4128-b24f-b18eba2e06e0",
      "name": "Alert Context Empty",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [620, 540],
      "notes": "CRITICAL via Post Alert (v1): context assembly returned empty -> pipeline aborted, no reply posted. Task id read from whichever trigger fired ($('When Called').isExecuted ? mention : form). onError:continueRegularOutput so the alert itself can't throw.",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "agent-orchestrator/context",
            "message": "Złożenie kontekstu zwróciło pusty wynik — pipeline przerwany, nie opublikowano odpowiedzi.",
            "details": "=task={{ $('When Called').isExecuted ? $('When Called').first().json.taskId : $('Form Trigger').first().json.taskId }}; trigger={{ $('When Called').isExecuted ? 'mention' : 'form' }}; sprawdź Assemble Context / Read Input dla tego zadania."
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "80baf910-eff7-4e63-8990-783e1110bfd9",
      "name": "Alert LLM Failed",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [940, 540],
      "notes": "CRITICAL via Post Alert (v1): model returned an empty completion -> no reply posted. Wired to the If LLM Succeeded? FALSE branch, which previously dead-ended silently (2026-06-11). onError:continueRegularOutput.",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "agent-orchestrator/llm",
            "message": "Model nie zwrócił treści (completion puste) — odpowiedź nie została opublikowana.",
            "details": "=task={{ $json.clickup_task_id }}; model={{ $json.model || 'brak' }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
