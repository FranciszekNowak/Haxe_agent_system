        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ value: '10290b3f-e47d-4157-a3d4-1bbd770918e8' }) }}",
        "options": {}
      },
      "credentials": {
        "clickUpApi": {
          "id": "QRrgf6hteyGWSJyv",
          "name": "ClickUp account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
