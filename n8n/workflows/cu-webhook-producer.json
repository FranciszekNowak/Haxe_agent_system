    {
      "id": "detect",
      "name": "Detect Mention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 120],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const AGENT_ID = 99811284;\nconst body = $('CU Webhook').first().json.body || {};\nconst taskId = body.task_id;\nconst items = (body.history_items || []).filter(h => h && h.field === 'comment' && h.comment);\nconst h = items[items.length - 1];\nlet matched = false, reviewer_user_id = '', caller_username = '';\nlet triggering_comment_id = '', triggering_comment_text = '';\nif (h) {\n  const ops = h.comment.comment || [];\n  const tagged = ops.some(b => b && b.type === 'tag' && b.user && Number(b.user.id) === AGENT_ID);\n  const author = h.comment.user || h.user || {};\n  if (tagged) {\n    matched = true;\n    reviewer_user_id = String(author.id || '');\n    caller_username = author.username || '';\n  }\n  triggering_comment_id = String(h.comment.id || h.id || '');\n  triggering_comment_text = h.comment.text_content\n    || ops.filter(op => op && op.type !== 'tag').map(op => op.text || '').join('')\n    || '';\n}\nreturn [{ json: { matched, taskId, reviewer_user_id, caller_username, triggering_comment_id, triggering_comment_text } }];"
      }
    },
