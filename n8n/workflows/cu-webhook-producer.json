    {
      "id": "f94dea23-b883-402a-8cf7-96a787d6cdbb",
      "name": "Claim Comment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1180, 340],
      "notes": "Webhook idempotency (ADR-029, migration 018_webhook_dedup, 2026-06-11). Atomic claim on the triggering comment id: INSERT ... ON CONFLICT DO NOTHING; the unique PK serialises the two near-simultaneous deliveries ClickUp sends for one @-mention (~45ms apart) so exactly one wins. Returns is_first (also true when comment id is empty -> never blocks). onError:continueRegularOutput + retry -> a DB blip fails OPEN (is_first undefined downstream).",
      "parameters": {
        "operation": "executeQuery",
        "query": "with ins as (\n  insert into agent_webhook_dedup (triggering_comment_id)\n  values ($1)\n  on conflict (triggering_comment_id) do nothing\n  returning 1\n)\nselect (exists (select 1 from ins) or coalesce($1, '') = '') as is_first;",
        "options": {
          "queryReplacement": "={{ [ $('Detect Mention').first().json.triggering_comment_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "cfce4a6c-b8e3-4d4b-8084-3f35c387a342",
      "name": "Not Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1400, 340],
      "notes": "is_first !== false -> proceed (true, incl. DB-error fail-open where is_first is undefined); is_first === false -> duplicate delivery, dead-end (drop). Complements the Recent Runs / Under Limit? loop-breaker: THIS kills exact-comment duplicates (at-least-once delivery), THAT caps agent->agent storms.",
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "dup1",
              "leftValue": "={{ $json.is_first !== false }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    }
