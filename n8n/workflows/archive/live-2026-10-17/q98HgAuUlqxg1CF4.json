  "name": "Due-Date Producer Freshness Monitor (v1)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 09:00 Warsaw",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        200
      ],
      "notes": "ADR-065 proactive dead-man's switch. Runs daily at 09:00 Europe/Warsaw (after the 01:00 producer). WARNs if config.due_date_producer.last_run_at is missing or older than 26h — a silently-stopped producer cron is the CLAUDE.md silent-degradation mode (overnight drafts would vanish unnoticed). Activate TOGETHER with the Daily Due-Date Producer; while the producer is inactive this would (correctly) WARN.",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "formseed",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        380
      ],
      "webhookId": "due-date-freshness-manual-seed",
      "notes": "Manual harness to test the freshness check on demand.",
      "parameters": {
        "formTitle": "Due-Date Producer Freshness Check (manual run)",
        "formDescription": "Press submit to check the producer heartbeat freshness.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "confirm",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "run"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode"
      }
    },
    {
      "id": "checkfresh",
      "name": "Check Heartbeat",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        280
      ],
      "notes": "Reads config.due_date_producer.last_run_at. should_alert = true when the row is missing (coalesce default true) OR last run > 26h ago. NO onError: a DB failure throws -> global Error Handler CRITICAL (a monitor that can't read its own signal must be LOUD, not fail silent).",
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce((now() - (select value from config where key='due_date_producer.last_run_at')::timestamptz) > interval '26 hours', true) as should_alert, (select value from config where key='due_date_producer.last_run_at') as last_run;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "stale",
      "name": "Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        280
      ],
      "notes": "should_alert=true -> Alert Stale; false (fresh) -> dead end.",
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ String($json.should_alert) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "alertstale",
      "name": "Alert Stale",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        700,
        180
      ],
      "notes": "WARN via Post Alert (v1) when the producer heartbeat is stale/missing.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "WARN",
            "source": "due-date-producer/freshness",
            "message": "Producent due-date NIE uruchomił się w ciągu ostatnich 26h (dead-man's switch). Nocne autonomiczne wersje robocze mogły nie powstać.",
            "details": "=heartbeat last_run={{ $('Check Heartbeat').first().json.last_run }}; próg=26h; sprawdź workflow Daily Due-Date Producer (v1): aktywny? cron 00:00? błędy w wykonaniach?"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
