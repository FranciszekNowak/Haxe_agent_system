  "id": "X3GEjMgmByZgDJnt",
  "name": "Managed Agents Auth Monitor (v1)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "notes": "ADR-053 Block 1: auth dead-man's-switch for the Managed Agents lane. Probes GET /v1/agents every 6h so a dead/expired Anthropic key (which would break the ENTIRE agentic lane) is caught within ~6h instead of silently at the next real task. GET /v1/agents is a free control-plane call (no tokens).",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "when-called",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        480
      ],
      "notes": "Test entry for Definition-of-Done verification via scripts/test-subworkflow.mjs (a Schedule Trigger cannot be fired over the n8n API; the Form-Trigger-over-API path mis-maps fields per CLAUDE.md). No inputs needed.",
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "get-key",
      "name": "Get Anthropic Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        380
      ],
      "notes": "Reads the anthropic_api_key Vault secret via the SECURITY DEFINER getter public.get_anthropic_key() (migration 034). Code nodes can't use n8n credentials and $env/$vars are unavailable on this CE (CLAUDE.md), so a credentialed Postgres read is how a workflow obtains the secret. Returns {key} (null until the secret is seeded).",
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.get_anthropic_key() as key;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "key-present",
      "name": "Key Present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        380
      ],
      "notes": "Distinguishes a config gap (secret not seeded in Vault) from an Anthropic-side auth failure, so the alert is actionable. Empty key -> CRITICAL 'seed the Vault secret'. Non-empty -> probe the live API. (main[1] is the IF false branch, not an error output.)",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-key",
              "leftValue": "={{ $json.key }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "probe",
      "name": "Probe MA Auth",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "onError": "continueErrorOutput",
      "notes": "GET /v1/agents with the managed-agents-2026-04-01 beta header. 2xx -> healthy (no alert). Any non-2xx/network error routes to the error output (onError: continueErrorOutput) -> CRITICAL. Block 0 confirmed this is the cheapest access probe.",
      "parameters": {
        "method": "GET",
        "url": "https://api.anthropic.com/v1/agents",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "healthy",
      "name": "Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        200
      ],
      "notes": "Terminal for the healthy path. Silent on purpose — a healthy probe must NOT post to the Alerts task every 6h (channel-noise + the Alerts task is webhook-watched elsewhere).",
      "parameters": {}
    },
    {
      "id": "alert-missing",
      "name": "Alert Key Missing",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        720,
        520
      ],
      "notes": "Routes CRITICAL through the centralized Post Alert (v1) seam (ADR-025) — never post to ClickUp directly.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list",
          "cachedResultName": "Post Alert (v1)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "managed-agents/auth",
            "message": "Sekret Vault 'anthropic_api_key' nie istnieje — lane Managed Agents (ADR-053) nie moze sie uwierzytelnic.",
            "details": "Zasiej sekret jednorazowo: select vault.create_secret('<ANTHROPIC_API_KEY>','anthropic_api_key','ADR-053'). Do czasu zasiania cala sciezka agentowa (Execute Agent Session, narzedzie generate_image) jest niedostepna. Getter: public.get_anthropic_key() (migracja 034)."
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "alert-failed",
      "name": "Alert Auth Failed",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        960,
        400
      ],
      "notes": "Routes CRITICAL through Post Alert (v1) when the live probe rejects the key or the API is unreachable.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list",
          "cachedResultName": "Post Alert (v1)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "managed-agents/auth",
            "message": "Sonda Managed Agents (GET /v1/agents) nie powiodla sie — klucz Anthropic odrzucony lub api.anthropic.com niedostepne.",
            "details": "=Blad: {{ (($json.error || {}).message) || $json.error || JSON.stringify($json).slice(0,300) }}. Sprawdz waznosc sekretu Vault 'anthropic_api_key', billing konta Anthropic oraz naglowek beta 'managed-agents-2026-04-01'. Bez dzialajacego klucza cala sciezka agentowa jest wstrzymana."
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    }
  ],
