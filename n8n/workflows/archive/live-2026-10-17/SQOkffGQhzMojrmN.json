{
  "updatedAt": "2026-06-29T10:51:03.551Z",
  "createdAt": "2026-06-26T11:36:41.351Z",
  "id": "SQOkffGQhzMojrmN",
  "name": "Spine HTTP Ingress (v1)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e2db55c2-0467-4347-a302-c19c1b8cbfbe",
      "notes": "Consumer (queue-consumer, ADR-056) POSTs here over the INTERNAL docker network (http://n8n-main:5678/webhook/spine-ingress), bypassing nginx's 300s proxy_read_timeout. responseMode=responseNode holds the connection for the whole spine run (up to 15 min, G5) and replies via the Respond node. The held HTTP response IS the authoritative spine-result signal — the consumer classifies from it, NOT by polling agent_runs (Block 0 G2).",
      "parameters": {
        "httpMethod": "POST",
        "path": "spine-ingress",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "callspine",
      "name": "Run Agent Orchestrator",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        260,
        0
      ],
      "onError": "continueErrorOutput",
      "alwaysOutputData": true,
      "notes": "Runs the Agent Orchestrator (a8XKaijkMFNBpRBa) inline, holding the webhook connection. onError=continueErrorOutput routes a thrown spine error to output 1 (-> Build Outcome (failed)) instead of bubbling a 500. alwaysOutputData=true guarantees output 0 carries >=1 item even when the orchestrator's branchy terminal returns 0 items (the n8n sub-workflow-return-determinism trap that produced the Block 0 'No item to return' 500) — so Build Outcome (completed) always has an item to coalesce. Maps the 7 spine inputs from the webhook body verbatim (unchanged from Block 0, which drove a real spine end-to-end).",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "a8XKaijkMFNBpRBa",
          "mode": "list",
          "cachedResultName": "Agent Orchestrator (v1)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "taskId": "={{ $json.body.taskId }}",
            "reviewer_user_id": "={{ $json.body.reviewer_user_id }}",
            "caller_username": "={{ $json.body.caller_username }}",
            "triggered_by": "={{ $json.body.triggered_by }}",
            "invocation_type": "={{ $json.body.invocation_type }}",
            "triggering_comment_id": "={{ $json.body.triggering_comment_id }}",
            "triggering_comment_text": "={{ $json.body.triggering_comment_text }}",
            "surface": "={{ $json.body.surface }}",
            "surface_ref": "={{ $json.body.surface_ref }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "okset",
      "name": "Build Outcome (completed)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        540,
        -120
      ],
      "notes": "Coalesces the success branch to ONE deterministic outcome item, independent of what the orchestrator's non-deterministic terminal returned. If the orchestrator happened to return its structured outcome ({status,outcome,failure_kind,warnings} from Call Execute Agent Session) those pass through; otherwise they default (status->completed, since the orchestrator ran without throwing). clickup_task_id is read from the Webhook body (always present). This shape is the consumer's classification contract (Block 0 G2 / Block 2).",
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "status",
              "value": "={{ $json.status || 'completed' }}",
              "type": "string"
            },
            {
              "id": "s2",
              "name": "outcome",
              "value": "={{ $json.outcome || 'ok' }}",
              "type": "string"
            },
            {
              "id": "s3",
              "name": "failure_kind",
              "value": "={{ $json.failure_kind || '' }}",
              "type": "string"
            },
            {
              "id": "s4",
              "name": "clickup_task_id",
              "value": "={{ $('Webhook').item.json.body.taskId }}",
              "type": "string"
            },
            {
              "id": "s5",
              "name": "warnings",
              "value": "={{ $json.warnings || [] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "failset",
      "name": "Build Outcome (failed)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        540,
        140
      ],
      "notes": "The orchestrator threw and onError routed here. Returns status=failed + failure_kind=orchestrator_exception + the error message as a deterministic 200 body (NOT an HTTP 5xx) so the consumer's HTTP client / BullMQ don't auto-retry a business failure (double-draft guard, Block 0 G2). The consumer (Block 2) classifies retryable-vs-DLQ from failure_kind + the message; genuine transport/timeout/n8n-5xx failures never reach here (the HTTP call itself fails) and are the consumer's retryable-infra path.",
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "status",
              "value": "failed",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "outcome",
              "value": "={{ ($json.error && ($json.error.message || $json.error.description)) || 'orchestrator error' }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "failure_kind",
              "value": "orchestrator_exception",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "clickup_task_id",
              "value": "={{ $('Webhook').item.json.body.taskId }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "warnings",
              "value": "={{ [ ($json.error && ($json.error.message || $json.error.description)) || 'orchestrator error' ] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        820,
        0
      ],
      "notes": "Single deterministic terminal for both branches (success XOR error -> exactly one item arrives). Always HTTP 200; the business outcome lives in the body's status field. This is what makes the held HTTP response an authoritative, deterministic spine-result signal (fixes the Block 0 bare-lastNode 500).",
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Run Agent Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Agent Orchestrator": {
      "main": [
        [
          {
            "node": "Build Outcome (completed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Outcome (failed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Outcome (completed)": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Outcome (failed)": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
