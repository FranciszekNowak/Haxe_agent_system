              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01,files-api-2025-04-14"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "getstatus",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.anthropic.com/v1/sessions/{{ $('When Called').first().json.session_id }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
