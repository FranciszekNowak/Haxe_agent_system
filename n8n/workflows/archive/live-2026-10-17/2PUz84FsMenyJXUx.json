              "name": "session_id"
            }
          ]
        }
      }
    },
    {
      "id": "getkey",
      "name": "Get Anthropic Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        460,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.get_anthropic_key() as key;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
