        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "summ",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "jsCode": "const ev = $('Get Events').first().json || {};\nconst st = $('Get Status').first().json || {};\nconst data = Array.isArray(ev.data) ? ev.data : [];\nconst types = {};\nfor (const e of data) types[e.type] = (types[e.type]||0)+1;\nconst hasDeliver = data.some(e => e.type==='agent.custom_tool_use' && e.name==='deliver_output');\nreturn [{ json: {\n  session_id: $('When Called').first().json.session_id,\n  events_retrievable: data.length > 0,\n  event_count: data.length,\n  event_types: types,\n  has_deliver_output: hasDeliver,\n  session_status: st.status || (ev.error ? 'events_error' : 'unknown'),\n  events_http_error: ev.error ? JSON.stringify(ev.error).slice(0,200) : '',\n  status_http_error: st.error ? JSON.stringify(st.error).slice(0,200) : ''\n} }];"
      }
    }
  ],
