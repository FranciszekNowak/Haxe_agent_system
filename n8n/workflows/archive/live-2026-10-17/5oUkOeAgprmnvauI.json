  "name": "Session Waiter Health Monitor (v1)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every 10m",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "notes": "ADR-066 Block 4: health dead-man's-switch for the always-on session-waiter service (http://session-waiter:8080). Pings GET /health every 10 min so a crashed/wedged/unreachable waiter — which once the managed lane runs through it would silently orphan EVERY long-running session — is caught within ~10 min. Mirrors Image MCP Health Monitor (v1).",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "when-called",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        480
      ],
      "notes": "Test entry for DoD verification via scripts/test-subworkflow.mjs (a Schedule Trigger cannot be fired over the n8n API). No inputs needed.",
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "probe",
      "name": "Probe Session Waiter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        380
      ],
      "notes": "GET the session-waiter /health on the internal network. 2xx (ok:true) -> Healthy; any non-2xx or network error (container down / wedged / not deployed) routes to the error output (onError) -> CRITICAL. Cheap endpoint, 10s timeout is ample.",
      "parameters": {
        "method": "GET",
        "url": "http://session-waiter:8080/health",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "id": "healthy",
      "name": "Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        520,
        280
      ],
      "notes": "Terminal for the healthy path. Silent on purpose — a healthy probe must NOT post to the Alerts task every 10 min.",
      "parameters": {}
    },
    {
      "id": "alert-down",
      "name": "Alert Waiter Down",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        520,
        480
      ],
      "notes": "CRITICAL via Post Alert (v1) seam (ADR-025) when the probe returns non-2xx or the endpoint is unreachable. Means the session-waiter container is down/wedged/not deployed. Fix: ssh the VPS, docker ps/docker logs session-waiter, docker compose up -d session-waiter.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "session-waiter/health",
            "message": "Sonda /health usługi session-waiter nie powiodła się — kontener niedostępny lub zawieszony. Długie sesje agenta (managed) mogą być po cichu porzucane.",
            "details": "=Błąd: {{ (($json.error || {}).message) || $json.error || JSON.stringify($json).slice(0,300) }}. Endpoint: http://session-waiter:8080/health. Sprawdź na VPS: docker ps / docker logs session-waiter; w razie potrzeby docker compose up -d session-waiter."
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    }
  ],
