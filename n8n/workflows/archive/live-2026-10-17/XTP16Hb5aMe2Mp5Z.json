  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "notes": "Dead-man's-switch for the FX import (ADR-025). Runs after the 06:00 FX cron. Catches BOTH cron-errored (Error Trigger also catches that) AND cron-silently-didn't-run (Error Trigger cannot).",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 30
            }
          ]
        }
      }
    },
    {
      "id": "check-fresh",
      "name": "Check FX Freshness",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        300
      ],
      "notes": "stale = latest rate_date is >4 days old (tolerates weekends + a holiday: NBP publishes business days only, so Friday's rate is latest through Mon/Tue) OR table empty. true => alert.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  max(rate_date) as latest_date,\n  coalesce((current_date - max(rate_date)) > 4, true) as stale,\n  (current_date - max(rate_date)) as age_days\nfrom fx_rates\nwhere base = 'USD' and quote = 'PLN';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      },
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "maxTries": 3
    },
    {
      "id": "if-stale",
      "name": "If Stale",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-stale",
              "leftValue": "={{ $json.stale }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "alert",
      "name": "Alert Stale FX",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        720,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "YSCdHlmdf3p9XEUx",
          "mode": "list",
          "cachedResultName": "Post Alert (v1)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "WARN",
            "source": "fx-freshness",
            "message": "Kurs USD/PLN (fx_rates) wygląda na nieaktualny — przeliczanie cost_pln może używać starego kursu NBP.",
            "details": "=Najnowszy rate_date = {{ $json.latest_date }} (wiek {{ $json.age_days }} dni, próg >4). Sprawdź workflow \"FX Rates Daily (v1)\" oraz dostępność api.nbp.pl."
          },
          "matchingColumns": [],
          "schema": [
