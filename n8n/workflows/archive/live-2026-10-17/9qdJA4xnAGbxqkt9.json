        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "CRITICAL",
            "source": "execute-llm/invoke-model",
            "message": "Wywołanie modelu LLM nie powiodło się — agent nie ukończył zadania.",
            "details": "=task={{ $('When Called').first().json.clickup_task_id }}; error={{ ($json.error && $json.error.message) || JSON.stringify($json.error) || 'unknown' }}; jeśli 429/cooldown: zrestartuj LiteLLM: cd /opt/haxe-agents && docker compose restart litellm"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      }
    },
    {
      "id": "call-write-cost-field",
      "name": "Call Write Cost Field",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        880,
        300
      ],
      "notes": "Bare lane cost write-back, now via the shared Write Cost Field (v1) sub-workflow (unification: both lanes write CU '[AI] Koszt akcji [PLN]' through ONE path). Runs AFTER Call Image Resolver so the SUM includes per-generate image_gen rows. The sub-workflow is internally fail-soft (WARNs + returns on DB/CU error); onError=continueRegularOutput here too so a cost-sync hiccup never blocks Return LLM Result. The comment footer still uses the per-run cost (Invoke Model) via Return LLM Result, unchanged.",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "GoFPwWsSQOHnrClH",
          "mode": "list"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "clickup_task_id": "={{ $('When Called').first().json.clickup_task_id }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
