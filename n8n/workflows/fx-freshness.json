{
  "name": "FX Freshness Monitor (v1)",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Daily 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 300],
      "notes": "Dead-man's-switch for the FX import (ADR-025). Runs after the 06:00 FX cron. Catches BOTH cron-errored (Error Trigger also catches that) AND cron-silently-didn't-run (Error Trigger cannot).",
      "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 7, "triggerAtMinute": 30 }] } }
    },
    {
      "id": "form-check",
      "name": "Check now (manual)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [0, 480],
      "webhookId": "fx-freshness-manual-check",
      "notes": "Manual harness to run the freshness check on demand (Schedule Trigger can't be fired via API).",
      "parameters": {
        "formTitle": "FX freshness check",
        "formDescription": "Press submit to evaluate fx_rates freshness now.",
        "formFields": { "values": [{ "fieldLabel": "confirm", "fieldType": "dropdown", "fieldOptions": { "values": [{ "option": "run" }] }, "requiredField": true }] },
        "responseMode": "lastNode"
      }
    },
    {
      "id": "check-fresh",
      "name": "Check FX Freshness",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [240, 300],
      "notes": "stale = latest rate_date is >4 days old (tolerates weekends + a holiday: NBP publishes business days only, so Friday's rate is latest through Mon/Tue) OR table empty. true => alert.",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "maxTries": 3,
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  max(rate_date) as latest_date,\n  coalesce((current_date - max(rate_date)) > 4, true) as stale,\n  (current_date - max(rate_date)) as age_days\nfrom fx_rates\nwhere base = 'USD' and quote = 'PLN';",
        "options": {}
      },
      "credentials": { "postgres": { "id": "EjK3iACTbSNRDhVz", "name": "Postgres / supabase connection" } }
    },
    {
      "id": "if-stale",
      "name": "If Stale",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "combinator": "and",
          "conditions": [{ "id": "c-stale", "leftValue": "={{ $json.stale }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }]
        }
      }
    },
    {
      "id": "alert",
      "name": "Alert Stale FX",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [720, 200],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "YSCdHlmdf3p9XEUx", "mode": "list", "cachedResultName": "Post Alert (v1)" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "severity": "WARN",
            "source": "fx-freshness",
            "message": "Kurs USD/PLN (fx_rates) wygląda na nieaktualny — przeliczanie cost_pln może używać starego kursu NBP.",
            "details": "=Najnowszy rate_date = {{ $json.latest_date }} (wiek {{ $json.age_days }} dni, próg >4). Sprawdź workflow \"FX Rates Daily (v1)\" oraz dostępność api.nbp.pl."
          },
          "matchingColumns": [],
          "schema": [
            { "id": "severity", "displayName": "severity", "type": "string", "canBeUsedToMatch": true, "required": false, "display": true, "defaultMatch": false },
            { "id": "source", "displayName": "source", "type": "string", "canBeUsedToMatch": true, "required": false, "display": true, "defaultMatch": false },
            { "id": "message", "displayName": "message", "type": "string", "canBeUsedToMatch": true, "required": false, "display": true, "defaultMatch": false },
            { "id": "details", "displayName": "details", "type": "string", "canBeUsedToMatch": true, "required": false, "display": true, "defaultMatch": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    }
  ],
  "connections": {
    "Daily 07:30": { "main": [[{ "node": "Check FX Freshness", "type": "main", "index": 0 }]] },
    "Check now (manual)": { "main": [[{ "node": "Check FX Freshness", "type": "main", "index": 0 }]] },
    "Check FX Freshness": { "main": [[{ "node": "If Stale", "type": "main", "index": 0 }]] },
    "If Stale": { "main": [[{ "node": "Alert Stale FX", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Warsaw", "errorWorkflow": "81eplXMD1v5ONhzs" }
}
