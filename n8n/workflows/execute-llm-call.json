      ]
    },
    "Sum Task Cost": {
      "main": [
        [{ "node": "Update CU Cost Field", "type": "main", "index": 0 }],
        [{ "node": "Alert Cost Sync Failed", "type": "main", "index": 0 }]
      ]
    },
    "Update CU Cost Field": {
      "main": [
        [{ "node": "Return LLM Result", "type": "main", "index": 0 }],
        [{ "node": "Alert Cost Sync Failed", "type": "main", "index": 0 }]
      ]
    },
    "Alert Cost Sync Failed": { "main": [[{ "node": "Return LLM Result", "type": "main", "index": 0 }]] }
  },
