{
  "name": "Session Events Probe (v1)",
  "active": true,
  "nodes": [
    {
      "id": "wc",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "ADR-066 A2 probe: given a session_id, fetch the managed key + the session events/status to confirm a session is still queryable (survival/retention probe). Reusable session-debugging helper.",
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "session_id"
            }
          ]
        }
      }
    },
    {
      "id": "getkey",
      "name": "Get Anthropic Key",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [460, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.get_anthropic_key() as key;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "EjK3iACTbSNRDhVz",
          "name": "Postgres / supabase connection"
        }
      }
    },
    {
      "id": "getevents",
      "name": "Get Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.anthropic.com/v1/sessions/{{ $('When Called').first().json.session_id }}/events",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Get Anthropic Key').first().json.key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01,files-api-2025-04-14"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "getstatus",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.anthropic.com/v1/sessions/{{ $('When Called').first().json.session_id }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Get Anthropic Key').first().json.key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "managed-agents-2026-04-01,files-api-2025-04-14"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "summ",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "jsCode": "const ev = $('Get Events').first().json || {};\nconst st = $('Get Status').first().json || {};\nconst data = Array.isArray(ev.data) ? ev.data : [];\nconst types = {};\nfor (const e of data) types[e.type] = (types[e.type]||0)+1;\nconst hasDeliver = data.some(e => e.type==='agent.custom_tool_use' && e.name==='deliver_output');\nreturn [{ json: {\n  session_id: $('When Called').first().json.session_id,\n  events_retrievable: data.length > 0,\n  event_count: data.length,\n  event_types: types,\n  has_deliver_output: hasDeliver,\n  session_status: st.status || (ev.error ? 'events_error' : 'unknown'),\n  events_http_error: ev.error ? JSON.stringify(ev.error).slice(0,200) : '',\n  status_http_error: st.error ? JSON.stringify(st.error).slice(0,200) : ''\n} }];"
      }
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Get Anthropic Key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Anthropic Key": {
      "main": [
        [
          {
            "node": "Get Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Events": {
      "main": [
        [
          {
            "node": "Get Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Status": {
      "main": [
        [
          {
            "node": "Summarize",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Summarize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "errorWorkflow": "81eplXMD1v5ONhzs"
  }
}
