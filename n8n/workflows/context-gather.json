      "id": "shape-context",
      "name": "Shape Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 560],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const CAP = 6;\nconst levels = [];\nfor (let i = 0; i < CAP; i++) {\n  let t;\n  try { t = $('Fetch L' + i).first().json; } catch (e) { break; }\n  if (!t || !t.id) break;\n  levels.push({ id: t.id, name: t.name, description: t.markdown_description || t.description || t.text_content || '', parent: t.parent || null, level: i });\n}\nconst deepest = levels.length ? levels[levels.length - 1] : null;\nconst truncated_at_depth = levels.length === CAP && !!(deepest && deepest.parent);\nconst current = levels.length ? levels[0] : null;\nconst ancestor_chain = levels.slice(1).map(l => ({ id: l.id, name: l.name, description: l.description, level: l.level }));\n\n// Importance custom field (ADR-023 routing input): [AI] Wpływ zadania na wynik firmy.\nconst IMPORTANCE_FIELD_ID = '55c7ff79-1857-41e6-87b4-bd46678e1470';\nconst IMPORTANCE_FALLBACK = {\n  'c40249e5-64e5-4703-893b-f5fb1cc5bfb4': 'n/d - zadanie nie jest dla AI',\n  '4c440e3f-94e8-4239-b9ec-54051090e2a4': 'Niski',\n  '1947d7f8-b394-4d7f-b555-9b2ad62fe38e': 'Średni',\n  '8c96537f-8bf8-405f-8a1c-c4fb39d80691': 'Wysoki',\n  '7780679d-6e30-466f-afae-d7728a31cbde': 'Krytycznie ważne'\n};\nlet importance = '';\ntry {\n  const l0 = $('Fetch L0').first().json;\n  const cf = (l0.custom_fields || []).find(f => f.id === IMPORTANCE_FIELD_ID);\n  const v = cf ? cf.value : undefined;\n  if (v !== undefined && v !== null && v !== '') {\n    const opts = (cf.type_config && cf.type_config.options) || [];\n    const match = opts.find(o => o.id === v) || opts.find(o => String(o.orderindex) === String(v));\n    importance = match ? match.name : (IMPORTANCE_FALLBACK[v] || '');\n  }\n} catch (e) {}\n\nreturn [{ json: { current_task: current ? { id: current.id, name: current.name, description: current.description } : null, ancestor_chain, linked_doc_leaves: [], truncated_at_depth, impact: importance } }];"
      }
    }
