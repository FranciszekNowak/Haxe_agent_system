# Copy this file to .env on the VPS at /opt/haxe-agents/.env
# NEVER commit .env — it holds real secrets.
# Generate values with: openssl rand -base64 24 (passwords) / openssl rand -hex 32 (keys)

POSTGRES_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_32_byte_hex_string
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
N8N_WORKER_CONCURRENCY=5
