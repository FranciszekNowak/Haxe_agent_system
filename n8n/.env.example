# Copy this file to .env on the VPS at /opt/haxe-agents/.env
# NEVER commit .env — it holds real secrets.
# Generate values with: openssl rand -base64 24 (passwords) / openssl rand -hex 32 (keys)

POSTGRES_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_32_byte_hex_string
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
N8N_WORKER_CONCURRENCY=5
# Public base URL of the n8n editor — makes execution links in alert messages
# clickable (ADR-025). Must match the Nginx vhost (ADR-012).
N8N_EDITOR_BASE_URL=https://agents.haxe.ai
# Public base URL n8n uses to generate webhook/form URLs (ADR-012). Same vhost.
WEBHOOK_URL=https://agents.haxe.ai

# LiteLLM gateway (ADR-024). The gateway needs the Bedrock IAM user's keys directly
# (it signs Bedrock itself). Same haxe-agents-bedrock IAM user as n8n's AWS credential;
# source from 1Password. AWS creds now live in two places (n8n's encrypted store AND
# this .env for LiteLLM) — acceptable: the IAM user is Bedrock-scoped.
LITELLM_MASTER_KEY=change_me_sk-style_key   # openssl rand -hex 24, prefix with sk-
# Key management (ADR-051): salt that encrypts DB-stored virtual keys at rest. Required once
# DATABASE_URL is set in docker-compose.yml (litellm reuses n8n-postgres via a `litellm` DB).
# Generate with: openssl rand -hex 32. NEVER change after keys are minted (it decrypts them).
LITELLM_SALT_KEY=change_me_32_byte_hex_string
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION_NAME=eu-central-1
# Anthropic direct API — used for non-GDPR tasks (personal_data=false, ADR-030).
# Source from Anthropic console -> API keys. Store in 1Password.
ANTHROPIC_API_KEY=change_me

# Web search backend (ADR-032). LiteLLM's interception callback runs the agent's
# web_search via Tavily on BOTH routes. Source from app.tavily.com -> API keys;
# store in 1Password. A Tavily DPA must be signed (queries may transit the US).
TAVILY_API_KEY=change_me

# Image generation providers (ADR-036, Block 8). Required for the multimodal output pipeline.
# Tiers (model_routing modality='image'): Niski/__default__ -> Vertex gemini-2.5-flash-image
# (Nano Banana), Średni -> Vertex gemini-3-pro-image-preview (Nano Banana Pro), Wysoki/Krytycznie
# ważne -> OpenAI gpt-image-2. Step-down fallback (Block 9) covers a missing provider.
# NOTE: Stability AI was dropped in Block 8 (STABILITY_API_KEY no longer used; the
# docker-compose passthrough is inert). The Vertex Imagen route was retired (Imagen shutdown
# ~2026-06-24..30) — Google's image tiers now ride the same Vertex creds below.
#
# GEMINI_API_KEY — unused (Gemini routes via Vertex AI + ADC). Kept optional in docker-compose.yml.
GEMINI_API_KEY=
#
# Vertex AI / Google Cloud — multimodal_input route (ADR-042/043) + image-gen tiers (Block 8).
# Service account key at /opt/haxe-agents/vertex-key.json (roles/aiplatform.user).
# GOOGLE_APPLICATION_CREDENTIALS is set directly in docker-compose.yml → mounted key file.
# Source key from 1Password; never commit it to the repo.
VERTEX_PROJECT=change_me          # GCP project ID (e.g. haxe-agent-system-499018)
VERTEX_LOCATION=                  # unused — all Vertex aliases hardcode `global`; kept for compose substitution
#
# OpenAI — gpt-image-2 image-gen tiers (Wysoki/Krytycznie ważne). platform.openai.com → API keys.
# Accept the OpenAI DPA + SCCs; no-training is the API default. ZDR + EU data residency are
# sales-gated (not self-serve) — pursue separately if required. Store in 1Password.
OPENAI_API_KEY=change_me
