{
  "mcpServers": {
    "n8n": {
      "command": "cmd",
      "args": ["/c", "npx", "n8n-mcp@2.56.0"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://agents.haxe.ai",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    }
  }
}
